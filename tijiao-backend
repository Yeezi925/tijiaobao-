def calculate_score(project, gender, performance):
    if project not in SCORING_STANDARDS or gender not in SCORING_STANDARDS[project]:
        return 0
    standards = SCORING_STANDARDS[project][gender]
    scores = sorted(standards.keys(), reverse=True)
    for score in scores:
        threshold = standards[score]
        if "跑" in project:  # 时间型：越小越好
            if performance <= threshold:
                return score
        else:  # 距离型如跳远：越大越好
            if performance >= threshold / 100:  # 假设标准单位是厘米，转米
                return score
    return 10  # 最低分

# 初始化数据库（仅首次运行）
def init_db():
    if not os.path.exists(DB_FILE):
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS students (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                gender TEXT NOT NULL,
                run_1000 REAL,
                run_50 REAL,
                long_jump REAL
            )
        ''')
        # 示例数据
        cursor.execute("INSERT INTO students (name, gender, run_1000, run_50, long_jump) VALUES ('张三', '男', 240, 7.8, 2.60)")
        cursor.execute("INSERT INTO students (name, gender, run_1000, run_50, long_jump) VALUES ('李四', '女', 250, 8.5, 2.00)")
        conn.commit()
        conn.close()

init_db()

@app.route('/api/grades', methods=['GET'])
def get_grades():
    student_id = request.args.get('student_id')
    if not student_id:
        return jsonify({"error": "缺少 student_id 参数"}), 400

    conn = get_db_connection()
    student = conn.execute('SELECT * FROM students WHERE id = ?', (student_id,)).fetchone()
    conn.close()

    if not student:
        return jsonify({"error": "未找到该学生"}), 404

    grades = {
        "name": student['name'],
        "gender": student['gender'],
        "run_1000": {
            "performance": student['run_1000'],
            "score": calculate_score("1000米跑", student['gender'], student['run_1000'])
        },
        "run_50": {
            "performance": student['run_50'],
            "score": calculate_score("50米跑", student['gender'], student['run_50'])
        },
        "long_jump": {
            "performance": student['long_jump'],
            "score": calculate_score("立定跳远", student['gender'], student['long_jump'])
        }
    }
    return jsonify(grades)

@app.route('/api/export', methods=['GET'])
def export_grades():
    student_id = request.args.get('student_id')
    if not student_id:
        return jsonify({"error": "缺少 student_id 参数"}), 400

    # 这里简单示例，实际可从数据库取完整数据
    data = [
        {"项目": "1000米跑", "成绩(秒)": 240, "得分": 80},
        {"项目": "50米跑", "成绩(秒)": 7.8, "得分": 85},
        {"项目": "立定跳远", "成绩(米)": 2.6, "得分": 90}
    ]
    df = pd.DataFrame(data)
    output = io.BytesIO()
    df.to_excel(output, index=False)
    output.seek(0)
    return send_file(
        output,
        mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        as_attachment=True,
        download_name=f'成绩单_{student_id}.xlsx'
    )

